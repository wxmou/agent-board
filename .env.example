# Public origin used in MCP URL responses. No trailing slash.
AGENT_BOARD_PUBLIC_URL=https://board.example.com

# Host port bound to 127.0.0.1 only. Put a TLS reverse proxy in front.
AGENT_BOARD_PORT=8080

# name:role:token
# Generate each token with: openssl rand -hex 32
# Roles: admin | writer
AGENT_BOARD_TOKENS=admin:admin:replace-with-a-long-random-token,agent-alpha:writer:replace-with-another-long-random-token

# Initial policy for an empty database. Existing database settings win.
AGENT_BOARD_RETENTION_DAYS=7
AGENT_BOARD_MAX_ITEMS=200
AGENT_BOARD_AUTO_ARCHIVE=true
AGENT_BOARD_ARCHIVE_INTERVAL_MINUTES=5

# Optional: comma-separated browser origins allowed to call the API.
AGENT_BOARD_CORS_ORIGINS=

AGENT_BOARD_VERSION=1.0.0
TZ=Asia/Shanghai
